---
import { LINKS } from '@consts';
import { cn } from '@lib/utils';
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
import Container from '@components/Container.astro';
---

<header id='header' class='fixed top-0 w-full md:h-16 h-12 z-50'>
    <Container size='md'>
        <div class='relative h-full w-full'>
            <div class='absolute left-0 top-1/2 -translate-y-1/2 flex gap-1 font-semibold'>
                <!-- LOGO GOES HERE -->
                <a
                    href='/'
                    class='flex gap-1 text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out md:hidden'>
                    <svg class='size-6 fill-current'>
                        <use href='/brand.svg#brand'></use>
                    </svg>
                </a>
            </div>

            <div class='absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2'>
                <nav class='hidden md:flex items-center justify-center text-sm gap-1'>
                    <!-- LOGO -->
                    <a
                        aria-label='Home'
                        href='/'
                        class='gap-1 text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out mr-6 md:block hidden'>
                        <svg class='size-6 fill-current'>
                            <use href='/brand.svg#brand'></use>
                        </svg>
                    </a>
                    {
                        LINKS.map((LINK) => (
                            <a
                                href={LINK.HREF}
                                aria-label={LINK.TEXT}
                                class={cn(
                                    'h-8 rounded-full px-3 text-current',
                                    'flex items-center justify-center',
                                    'transition-colors duration-300 ease-in-out',
                                    pathname === LINK.HREF || '/' + subpath?.[0] === LINK.HREF
                                        ? ' text-black dark:text-white underline-link'
                                        : ' hover:text-black dark:hover:text-white hover:underline-link'
                                )}>
                                {LINK.TEXT}
                            </a>
                        ))
                    }
                </nav>
            </div>

            <!-- Mobile hamburger button -->
            <div class='buttons absolute right-0 top-1/2 -translate-y-1/2 flex gap-2'>
                <button
                    id='header-drawer-button'
                    aria-label={`Toggle drawer open and closed`}
                    class={cn(
                        'flex md:hidden',
                        'size-8 rounded-md items-center justify-center',
                        'bg-transparent md:hover:bg-black/5 md:dark:hover:bg-white/20',
                        'transition-all duration-300 ease-in-out'
                    )}>
                    <div class='burger-icon'>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </button>
            </div>
        </div>
    </Container>
</header>

<style>
    .burger-icon {
        width: 25px;
        height: 15px;
        position: relative;
        transform: rotate(0deg);
        transition: 0.5s ease-in-out;
    }

    .burger-icon span {
        display: block;
        position: absolute;
        height: 2px;
        width: 100%;
        background: currentColor;
        border-radius: 2px;
        opacity: 1;
        left: 0;
        transform: rotate(0deg);
        transition: 0.25s ease-in-out;
    }

    .burger-icon span:nth-child(1) {
        top: 0px;
    }

    .burger-icon span:nth-child(2) {
        top: 7px;
    }

    .burger-icon span:nth-child(3) {
        top: 14px;
    }

    #header-drawer-button.open .burger-icon span:nth-child(1) {
        top: 6px;
        transform: rotate(135deg);
    }

    #header-drawer-button.open .burger-icon span:nth-child(2) {
        opacity: 0;
        left: 0px;
    }

    #header-drawer-button.open .burger-icon span:nth-child(3) {
        top: 6px;
        transform: rotate(-135deg);
    }
</style>

<script>
    function toggleDrawer() {
        const drawer = document.getElementById('drawer');
        const drawerButton = document.getElementById('header-drawer-button');
        drawer?.classList.toggle('open');
        drawerButton?.classList.toggle('open');

        if (drawer?.classList.contains('open')) {
            animateMenuItems();
        }
    }

    function animateMenuItems() {
        const menuItems = document.querySelectorAll('#drawer .menu-item');
        menuItems.forEach((item, index) => {
            (item as HTMLElement).style.animation = `fadeInUp 0.5s ease forwards ${index * 0.1}s`;
        });
    }

    function initializeDrawerButton() {
        const drawerButton = document.getElementById('header-drawer-button');
        drawerButton?.addEventListener('click', toggleDrawer);
    }

    document.addEventListener('astro:after-swap', initializeDrawerButton);
    initializeDrawerButton();
</script>

<style is:global>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #drawer .menu-item {
        opacity: 0;
    }
</style>
