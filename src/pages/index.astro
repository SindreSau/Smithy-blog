---
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@consts';
import { Image, Picture } from 'astro:assets';
import Button from '@components/Button.astro';
import { Divider } from '@nextui-org/divider';

// @ts-ignore
import background_image from '../assets/images/pc_bg.JPG';
// @ts-ignore
import background_image_mobile from '../assets/images/mobile_bg.JPG';

// @ts-ignore
import smie from '../assets/images/smed.png';

import bilde_venstre from '../assets/images/index_left.jpeg';
import bilde_midten from '../assets/images/index_center.jpeg';
import bilde_hoyre from '../assets/images/index_right.jpg';
---

<PageLayout title='Hjem' description={SITE.DESCRIPTION}>
    <!-- BACKGROUND IMAGE -->
    <div
        id='background-desktop'
        class='animate fixed w-full h-full hidden md:block'
        style={{
            backgroundImage: `linear-gradient(rgba(8,8,8,0.5), rgba(8,8,8,0.5)), url(${background_image.src})`,
            backgroundSize: 'cover',
            backgroundPosition: 'center',
        }}
        data-bg-url={background_image.src}>
    </div>
    <div
        id='background-mobile'
        class='animate fixed w-full h-full md:hidden'
        style={{
            backgroundImage: `linear-gradient(rgba(8,8,8,0.5), rgba(8,8,8,0.5)), url(${background_image_mobile.src})`,
            backgroundSize: 'cover',
            backgroundPosition: 'center',
        }}
        data-bg-url={background_image_mobile.src}>
    </div>
    <!-- HERO -->
    <section class='relative h-screen w-full'>
        <div class='animate absolute h-full w-full flex items-center justify-center'>
            <div class='relative w-full h-full flex justify-center'>
                <h1 class='md:text-6xl sm:text-3xl text-2xl flex md:items-end my-32'>BOGSTAD SMIE</h1>
            </div>
        </div>
    </section>

    <!-- Main section -->
    <div class='relative bg-white dark:bg-darkness md:pt-24 pt-6'>
        <div class='mx-auto flex flex-col md:gap-24 gap-8 items-center max-w-screen-lg p-5'>
            <!-- About Section -->
            <section class='flex flex-col md:flex-row md:items-start gap-4 md:gap-10'>
                <div class='w-full md:w-2/3'>
                    <h2 class='text-xl md:text-2xl font-semibold mb-3 md:mb-8'>Velkommen til smia på Bogstad Gård</h2>
                    <div class='flex flex-col gap-1.5'>
                        <p>
                            Håkon Busk er smed på Bogstad Gård og har en Bachelor of Arts i kunstsmiing fra Hereford,
                            School of Arts and Crafts i England.
                        </p>
                        <p>
                            I arbeidet sitt ønsker han å fremme kvalitet i minimalistisk moderne design som håndlages på
                            Bogstad Gård. Dette tar form som skulpturer, interiørdesign og eksteriørdesign som
                            spesialtilpasses i smidd stål.
                        </p>
                        <p>
                            Håkon tar bestillinger der han samarbeider tett med kunder for å utvikle og skape
                            skreddersydde ideer og produkter til kundens behov.
                        </p>
                    </div>
                </div>
                <Image
                    class='w-full max-w-80 md:w-1/3 rounded-md self-center'
                    src={smie}
                    alt={'Smie'}
                    widths={[120, 240, 360, 480, 600]}
                    quality={'mid'}
                    sizes={'(max-width: 768px) 100vw, 50vw'}
                    loading={'eager'}
                />
            </section>

            <Divider className='opacity-30' />

            <!-- Images section -->
            <section>
                <div class='grid grid-cols-1 md:grid-cols-3 md:gap-8 gap-4'>
                    <Image
                        class='rounded-md object-cover md:h-[25rem] h-[18rem] img-zoom'
                        src={bilde_venstre}
                        alt={'Skulptur'}
                        widths={[240, 360, 480, 600, 720]}
                        quality={'mid'}
                        loading={'eager'}
                    />
                    <Image
                        class='rounded-md object-cover md:h-[25rem] h-[18rem] img-zoom'
                        src={bilde_midten}
                        alt={'Skulptur'}
                        widths={[240, 360, 480, 600, 720]}
                        quality={'mid'}
                        loading={'eager'}
                    />
                    <Image
                        class='rounded-md object-cover md:h-[25rem] h-[18rem] img-zoom'
                        src={bilde_hoyre}
                        alt={'Skulptur'}
                        widths={[240, 360, 480, 600, 720]}
                        quality={'mid'}
                        loading={'eager'}
                    />
                </div>
                <div
                    class='max-w-screen-md mx-auto flex md:flex-row flex-col items-center justify-center md:gap-8 md:mt-6 pt-2'>
                    <p class='mt-4'>Ta en kikk i galleriet for å se mer.</p>

                    <a href='/galleri'>
                        <Button btntext='Til galleri' />
                    </a>
                </div>
            </section>

            <!-- Contact section -->
            <section class='flex justify-center md:mb-16'>
                <div>
                    <p class='font-bold text-xl'>Kontakt:</p>
                    <p>Ta gjerne kontakt for oppdrag og spesialbestillinger</p>
                    <div class='grid grid-cols-4 gap-2 mt-4 auto-cols-min'>
                        <!-- Mail -->
                        <div class='col-span-1 flex items-center gap-1'>
                            <span class='whitespace-nowrap truncate'>E-mail:</span>
                        </div>
                        <div class='col-span-3 truncate'>
                            <a
                                href={'mailto:hawk.metaldesigns@gmail.com'}
                                target='_blank'
                                class='w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend'>
                                <span
                                    class='text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend'>
                                    hawk.metaldesigns@gmail.com
                                </span>
                            </a>
                        </div>
                        <!-- Phone -->
                        <div class='col-span-1 flex items-center gap-1'>
                            <span class='whitespace nowrap truncate'>Telefon:</span>
                        </div>
                        <div class='col-span-3 truncate'>
                            <a
                                href={'tel:48241206'}
                                target='_blank'
                                class='w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend'>
                                <span
                                    class='text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend'>
                                    48241206
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <script>
        function handleScroll() {
            const scrollPosition = window.scrollY;
            const windowHeight = window.innerHeight;

            const desktopBg = document.getElementById('background-desktop');
            const mobileBg = document.getElementById('background-mobile');

            // Adjust this value to make it become dark gray sooner (higher value = sooner)
            const darkenFactor = 1.5;

            // Calculate the additional darkness (0 = no additional darkness, 0.5 = fully dark gray)
            const additionalDarkness = Math.min(0.5, (scrollPosition / windowHeight) * darkenFactor);

            // Combine initial darkness (0.5) with additional darkness
            const totalDarkness = 0.65 + additionalDarkness;

            const gradient = `linear-gradient(rgba(8,8,8,${totalDarkness}), rgba(8,8,8,${totalDarkness}))`;

            if (desktopBg) {
                const bgUrl = desktopBg.getAttribute('data-bg-url');
                desktopBg.style.backgroundImage = `${gradient}, url(${bgUrl})`;
            }
            if (mobileBg) {
                const bgUrl = mobileBg.getAttribute('data-bg-url');
                mobileBg.style.backgroundImage = `${gradient}, url(${bgUrl})`;
            }
        }

        window.addEventListener('scroll', handleScroll);
        window.addEventListener('resize', handleScroll);

        // Initial call to set correct darkness on page load
        handleScroll();
    </script>
</PageLayout>
